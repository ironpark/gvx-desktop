# Pinned build toolchain for release/repro-build.sh and .github/workflows/release.yml.
# Update these values together when bumping Go or the ggui CLI.
GO_VERSION=1.27.4
GGUI_VERSION=v0.7.5
GOPROXY=https://proxy.golang.org/
GOSUMDB=sum.golang.org
GOAMD64_LINUX=v2
GOAMD64_WINDOWS=v2
GOAMD64_DEFAULT=v1
GOARM64_DARWIN=v8.4
GOARM64_WINDOWS=v8.1
GOARM64_LINUX=v8.0
